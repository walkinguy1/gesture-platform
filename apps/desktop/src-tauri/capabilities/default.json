{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main Gesture Platform window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**" },
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "$DESKTOP" },
        { "path": "$DESKTOP/**" }
      ]
    }
  ]
}
